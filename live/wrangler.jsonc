{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ogdeliveries2",
  "compatibility_date": "2026-05-10",
  "main": "worker.js",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
